# Copy this file to ".env" and fill in your real keys.
# Never commit the real ".env" file to git.

# Google AI Studio key -> https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Tavily key -> https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# RapidAPI key (subscribe to the free JSearch plan) -> https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
